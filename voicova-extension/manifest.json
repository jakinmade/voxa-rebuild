{
  "manifest_version": 3,
  "name": "VOICOVA Voice Check",
  "version": "0.2.0",
  "description": "Checks your LinkedIn and Gmail drafts against your own voice before you send.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["storage", "alarms"],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://mail.google.com/*",
    "https://web-production-dbceb0.up.railway.app/*"
  ],

  "externally_connectable": {
    "matches": [
      "https://voicova.com/*",
      "https://web-production-dbceb0.up.railway.app/*"
    ]
  },

  "background": {
    "service_worker": "background/service_worker.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["shared/state_machine.js", "shared/panel.js", "content_scripts/linkedin.js"],
      "css": ["shared/panel.css"]
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["shared/state_machine.js", "shared/panel.js", "content_scripts/gmail.js"],
      "css": ["shared/panel.css"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html"
  }
}
