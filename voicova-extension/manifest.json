{
  "manifest_version": 3,
  "name": "VOICOVA Voice Check",
  "version": "0.1.0",
  "description": "Checks your LinkedIn drafts against your own voice before you post.",

  "permissions": ["storage", "alarms"],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://voicova-api.up.railway.app/*"
  ],

  "externally_connectable": {
    "matches": ["https://voicova.com/*"]
  },

  "background": {
    "service_worker": "background/service_worker.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["shared/state_machine.js", "shared/panel.js", "content_scripts/linkedin.js"],
      "css": ["shared/panel.css"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html"
  }
}
