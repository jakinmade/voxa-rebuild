# VOICOVA (web service) — environment variable template
#
# This mirrors exactly what is configured on Railway (project inspiring-mercy,
# service `web`) as of 2 Sept 2026 — checked var-by-var against
# `Railway:list-variables`, not guessed from code. Keep this file 1:1 with
# Railway's actual variable list; update both together.
#
# RAILWAY_* vars are injected automatically by the platform — do not set
# them manually, they are listed here only so the full picture is visible.
#
# Copy to .env for local development and fill in real values. Never commit
# a filled-in .env file.

# --- Core app / AI ---
ANTHROPIC_API_KEY=
MAX_LIFETIME_RENDERS=

# --- Supabase (persistence, render-cap, subscription status) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Stripe (subscription checkout + billing) ---
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- SendGrid (restore-subscription magic-link email) ---
SENDGRID_API_KEY=
VOICOVA_EMAIL_FROM=hello@voicova.com

# --- Sentry (error tracking, added 2 Sept 2026) ---
SENTRY_DSN=

# --- App URLs ---
VOICOVA_APP_URL=http://localhost:8501

# --- Railway platform vars (auto-injected, do not set manually) ---
# RAILWAY_ENVIRONMENT=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_ENVIRONMENT_NAME=
# RAILWAY_PRIVATE_DOMAIN=
# RAILWAY_PROJECT_ID=
# RAILWAY_PROJECT_NAME=
# RAILWAY_PUBLIC_DOMAIN=
# RAILWAY_SERVICE_ID=
# RAILWAY_SERVICE_NAME=
# RAILWAY_SERVICE_WEB_URL=
# RAILWAY_STATIC_URL=
# PYTHONUNBUFFERED=1

# --- Referenced in code, not currently set on Railway (uses safe defaults) ---
# EMAIL_ENABLED=true          # kill-switch for SendGrid sends (send_report_email)
# MAX_RENDERS_PER_DAY=        # daily render cap, separate from lifetime cap
# RUN_BROWSER_TESTS=          # gates the AppTest browser-driven test suite
