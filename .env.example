# Voxa (VOICOVA) — required environment variables
# Generated 2 Sept 2026 (hardening pass) by scanning app code for every
# os.environ / os.getenv / _get_secret() call, then diffed against the
# live Railway "web" service (inspiring-mercy project) variable list.
# Keep this in sync: when code starts reading a new env var, add it here
# in the same change — that's what makes a missing var show up in a
# diff instead of being discovered by a failed checkout or a broken
# webhook, the way STRIPE_WEBHOOK_SECRET and an invalid sk_live key
# were both found in the past.

# --- Required — app will not function correctly without these ---

# Anthropic API key, used by the core voice engine
ANTHROPIC_API_KEY=

# Supabase — cross-device persistence (persistence.py, supabase_client.py)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Stripe — subscription checkout (stripe_subscription.py, _get_secret)
STRIPE_API_KEY=

# SendGrid — restore-subscription magic-link emails (stripe_subscription.py)
SENDGRID_API_KEY=

# --- Optional — coded defaults shown; only set to override ---

# Restore-subscription email sender address. Default: hello@voicova.com
VOICOVA_EMAIL_FROM=

# Kill switch for outbound email. Default: true (enabled)
# EMAIL_ENABLED=false

# Base URL used in generated links (e.g. restore emails). Default: http://localhost:8501
VOICOVA_APP_URL=

# Global daily render ceiling (see render_cap.py). Default: 40
MAX_RENDERS_PER_DAY=

# Per-device lifetime free-render cap (see lifetime_cap.py). Default: 15
MAX_LIFETIME_RENDERS=

# --- Dev/test only — not needed in production ---
# RUN_BROWSER_TESTS=

# --- NOT used by this service — do not add here ---
# The following are currently set on Railway's "web" service but are
# never read anywhere in this codebase (confirmed by full-repo scan,
# 2 Sept 2026). They may be leftover from an earlier iteration or
# genuinely belong to a different service reading the same Railway
# environment. Flagged here so nobody assumes editing one of these on
# Railway affects this app, and so the real owner (if any) gets
# reconciled during the Week 0 infra audit rather than staying silent:
#   STRIPE_PUBLISHABLE_KEY
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET   (this app's Stripe webhook is handled by
#                            the separate voicova-webhooks Cloudflare
#                            Worker, which has its own env config —
#                            confirm that's still the only consumer)
