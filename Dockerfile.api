FROM python:3.12-slim

# Note for future debugging (6 Sept 2026): Railway's own `redeploy`
# API/tool call reuses an already-built image rather than triggering
# a fresh build — so a dockerfilePath change (or any other build-time
# config change) applied via the API will NOT take effect via
# redeploy alone, even though get-service-config immediately reflects
# the new setting. Only a genuine new build — a real git push — re-
# evaluates build config from scratch. Confirmed the hard way: two
# consecutive redeploys after setting dockerfilePath both failed
# identically ("couldn't locate a dockerfile at path Dockerfile"),
# because both reused a build snapshot computed before dockerfilePath
# existed at all. Also: this Dockerfile exists at all because Railway
# kept deferring to the shared repo's Procfile (Streamlit) despite a
# correctly-configured startCommand — "Railway will always build with
# a Dockerfile if it finds one" (Railway's own docs) is the
# deterministic override used here, rather than continuing to fight
# Railpack's config-as-code precedence.

WORKDIR /app

# requirements.lock, not requirements.txt: hash-pinned, reproducible,
# same file CI already installs successfully (Foundation Hardening
# item 1) — this Dockerfile installs no differently than the tested
# path, just via `docker build` instead of Railpack.
COPY requirements.lock .
RUN pip install --no-cache-dir -r requirements.lock

COPY . .

# Exec form, invoking Python directly — no shell in this process at
# all, so there is no shell-expansion step for anything to go wrong
# in. See run_api.py's own docstring for exactly why this replaced an
# `sh -c "uvicorn ... --port $PORT"` form that failed three times in a
# row on real Railway deployments (6 Sept 2026).
CMD ["python", "run_api.py"]
